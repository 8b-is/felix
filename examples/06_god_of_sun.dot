digraph felix {
  node [fontname="monospace"];
  s0 [shape=box, label="let qat_horizon: Ratio = god_of_sun(31/32, 31, -1)"];
  s1 [shape=box, label="let zen_horizon: Ratio = god_of_sun(39/40, 39, -1)"];
  s2 [shape=box, label="let sub_horizon: Ratio = god_of_sun(31/32, 30, -1)"];
  s3 [shape=note, label="print(qat_horizon)"];
  s4 [shape=note, label="print(zen_horizon)"];
  s5 [shape=note, label="print(sub_horizon)"];
  s0 -> s3;
  s1 -> s4;
  s2 -> s5;
}
