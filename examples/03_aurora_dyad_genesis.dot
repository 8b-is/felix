digraph felix {
  node [fontname="monospace"];
  s0 [shape=note, label="print(genesis_seal())"];
  s1 [shape=note, label="print(aurora_seal())"];
  s2 [shape=note, label="print(paprika_root())"];
  s3 [shape=box, label="let folded: Word = spherepop_fold([…16])"];
  s4 [shape=box, label="let weights: Word = pack([…16], 1)"];
  s5 [shape=note, label="print(folded)"];
  s6 [shape=note, label="print(weights <~> folded)"];
  s7 [shape=note, label="print(toss_freedom(1))"];
  s8 [shape=note, label="print(toss_freedom(5))"];
  s9 [shape=note, label="print(toss_freedom(6))"];
  s10 [shape=note, label="print(toss_freedom(9))"];
  s11 [shape=box, peripheries=2, label="linear let vault: Vault = new_vault()"];
  s12 [shape=octagon, label="consume(vault)"];
  s3 -> s5;
  s4 -> s6;
  s3 -> s6;
  s11 -> s12 [style=bold, label="consume"];
}
