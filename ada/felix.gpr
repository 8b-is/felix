project Felix is
  for Source_Dirs use (".");
  for Object_Dir use "obj";
  for Exec_Dir use "obj";
  for Main use ("felix_repl.adb", "run_benchmarks.adb");

  package Builder is
    for Executable ("felix_repl.adb") use "felix";
    for Executable ("run_benchmarks.adb") use "run_benchmarks";
  end Builder;

  package Compiler is
    for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-O2", "-gnatn");
  end Compiler;

  package Binder is
    for Default_Switches ("Ada") use ("-E");
  end Binder;

  package Prove is
    for Proof_Switches ("Ada") use ("--level=2", "--report=all");
  end Prove;

end Felix;