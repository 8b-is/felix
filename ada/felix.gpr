project Felix is
  for Source_Dirs use (".");
  for Object_Dir use "obj";
  for Main use ("felix_nand_tcb.adb");

  -- SPARK 2022 mode
  package Builder is
    for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwl",
                                     "-gnatVa", "-gnatVe", "-gnatVc",
                                     "-gnatVp", "-gnatVu", "-gnatVd",
                                     "-gnatVn", "-gnatVh", "-gnatVr",
                                     "-gnatVo", "-gnatVt", "-gnatVy",
                                     "-gnatVz", "-gnatVf", "-gnatVg");
  end Builder;

  package Compiler is
    for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwl",
                                      "-gnatVa", "-gnatVe", "-gnatVc",
                                      "-gnatVp", "-gnatVu", "-gnatVd",
                                      "-gnatVn", "-gnatVh", "-gnatVr",
                                      "-gnatVo", "-gnatVt", "-gnatVy",
                                      "-gnatVz", "-gnatVf", "-gnatVg",
                                      "--gnateD", "--gnatyO",
                                      "-O2", "-gnatn",
                                      "-gnatec=project.cgpr");
  end Compiler;

  package Binder is
    for Default_Switches ("Ada") use ("-E", "-xa", "-xn");
  end Binder;

  package Linker is
    for Default_Switches ("Ada") use ("-static", "-Wl,--gc-sections");
  end Linker;

  package Prove is
    for Default_Switches use ("--level=2", "--replay", "--report=all",
                              "--counterexample", "--steps=10000");
  end Prove;

  package Naming is
    for Casing use "lower_case";
    for Dot_Replacement use "_";
  end Naming;

  -- SPARK configuration
  package Spark is
    for Mode use "On";
  end Spark;

end Felix;