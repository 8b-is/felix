FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GNAT and tools
RUN apt-get update && apt-get install -y \
    gnat-14 \
    gprbuild \
    bash \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/gnat-14/bin:${PATH}"

# Create symlinks for versioned tools
RUN ln -sf /usr/bin/gnatbind-14 /usr/bin/gnatbind && \
    ln -sf /usr/bin/gnatlink-14 /usr/bin/gnatlink && \
    ln -sf /usr/bin/gnatmake-14 /usr/bin/gnatmake && \
    ln -sf /usr/bin/gnatkr-14 /usr/bin/gnatkr

WORKDIR /src

COPY . .

# Build
RUN gprbuild -P felix.gpr -j0

# Find binaries
RUN find /src -name "felix_nand_tcb" -o -name "felix_repl" -o -name "run_benchmarks" 2>/dev/null