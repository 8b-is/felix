FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GNAT and SPARK tools
RUN apt-get update && apt-get install -y \
    gnat \
    gnatprove \
    gnatpp \
    gnatcheck \
    gnatdoc \
    gprbuild \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . .

# Build and prove
RUN gprbuild -P felix.gpr -j0 && \
    gnatprove -P felix.gpr --level=2 --replay --report=all --counterexample --steps=10000

# Run tests
RUN ./test_harness.sh ./obj/felix_nand_tcb

# Run benchmarks
RUN ./run_benchmarks 100000 10000