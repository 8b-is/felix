FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install GNAT and available tools
RUN apt-get update && apt-get install -y \
    gnat-14 \
    gprbuild \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/gnat-14/bin:${PATH}"

WORKDIR /src

COPY . .

# Build (skip prove for now - gnatprove not in Ubuntu default repos)
RUN gprbuild -P felix.gpr -j0

# Run tests
RUN ./test_harness.sh ./obj/felix_nand_tcb

# Run benchmarks
RUN ./run_benchmarks 100000 10000